{
    "font": "MonaspiceNe NFP",
    "fontSize": 13,
    "iconSize": 15,
    "barHeight": 34,
    "gap": 6,
    "radius": 10,
    "pillPadding": 10,
    "clock": {
        "dateFormat": "ddd d MMM",
        "timeFormat": "HH:mm"
    },
    "bar": {
